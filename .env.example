# --- Geral ---
ENVIRONMENT=development
SECRET_KEY=changeme-generate-a-strong-random-key
API_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sigil
POSTGRES_USER=sigil_user
POSTGRES_PASSWORD=changeme

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- MinIO (Object Storage WORM) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET_EVIDENCIAS=sigil-evidencias

# --- Qdrant (busca vetorial) ---
QDRANT_URL=http://localhost:6333

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Kafka ---
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_EVIDENCIAS=evidencias.criadas
KAFKA_TOPIC_PIPELINE=pipeline.processamento

# --- Autenticação / MFA ---
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
MFA_ISSUER_NAME=SIGIL

# --- IA / Modelos ---
WHISPER_MODEL=base
SPACY_MODEL=pt_core_news_lg
